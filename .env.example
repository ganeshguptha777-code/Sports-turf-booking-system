# ---------------------------------------------------------------
# TurfBook local environment
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------

# Local MongoDB (or a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/turfbook

# Use a long, random value in production.
JWT_SECRET=change-this-to-a-long-random-string

# API port (the Vite dev server proxies /api requests here)
PORT=5000

# development | production
NODE_ENV=development

# Used to build compliant dates / availability for this locale
TIMEZONE=Asia/Kolkata

# Seed venues, demo users and sample bookings when the database is empty.
SEED_DEMO=true

# Optional seed overrides
ADMIN_EMAIL=admin@turfbook.in
ADMIN_PASSWORD=Admin@1234
DEMO_EMAIL=demo@turfbook.in
DEMO_PASSWORD=Demo@1234

# Only needed if the frontend is served from a different origin.
# CLIENT_URL=http://localhost:5173
